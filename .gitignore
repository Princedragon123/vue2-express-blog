# ============================================================
# 上传文件排除规则（用户动态内容 + 大文件）
# ============================================================

# 音乐压缩包（504MB 巨大，完全没必要）
src/uploads/music.zip

# FLAC 无损音乐（版权风险 + 单文件超100MB限制）
src/uploads/music/*.flac

# 用户动态上传内容（无数据库则无用）
src/uploads/blogs/
src/uploads/backgrounds/
src/uploads/avatars/
src/uploads/videos/

# 歌词文件（版权问题）
src/uploads/musicLyrics/

# ============================================================
# 工具脚本 & 测试文件（开发工具，不需要上传）
# ============================================================

# MongoDB 导入导出工具
export-mongodb.js
export-mongodb.bat
import-mongodb.js

# 检查/测试脚本
check-follows.js
check-image-paths.js
test_api.js
test_follow_api.js
test-jwt.js

# 打包文件
dist.zip

